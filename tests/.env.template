# 模型服务地址（OpenAI / OpenAI-Compatible / Local Gateway）
BASE_URL=https://api.openai.com/v1
# API KEY
API_KEY=your_api_key_here
# 模型名称
MODEL_NAME=gpt-5.5
# 模型提供方
# supported by LangChain:
# openai / anthropic / google / azure_openai / ollama / etc.
MODEL_PROVIDER=openai
# 温度（0~1）
TEMPERATURE=0.2
# 最大 token 数
MAX_TOKENS=1024
# 请求超时（秒）
TIMEOUT=1200
# 最大重试次数
MAX_RETRIES=3
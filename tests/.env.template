# 模型服务地址（OpenAI / OpenAI-Compatible / Local Gateway）
BASE_URL=
# API KEY
API_KEY=
# 模型名称
MODEL_NAME=
# 模型提供方
# supported by LangChain:
# openai / anthropic / google / azure_openai / ollama / etc.
MODEL_PROVIDER=openai
# 温度（0~1）
TEMPERATURE=0
# 最大 token 数
MAX_TOKENS=32768
# 请求超时（秒）
TIMEOUT=1200
# 是否允许模型并行调用工具
PARALLEL_TOOL_CALLS=true
# 最大重试次数
MAX_RETRIES=3
# 是否使用 Responses API
USE_RESPONSES_API=true
# AIMessage 输出版本（Responses API 推荐 responses/v1）
OUTPUT_VERSION=responses/v1
# 思考模式配置（none/low/high/max）
REASONING_EFFORT="low"
# 模型内置工具（JSON 数组，按 provider/模型能力配置）
# Qwen 示例: [{"type":"web_search"},{"type":"web_extractor"},{"type":"code_interpreter"}]
# OpenAI 示例: [{"type":"web_search_preview"},{"type":"code_interpreter"}]
BUILTIN_TOOLS=[]
# provider 扩展请求参数（JSON 对象）
# Qwen 示例: {"enable_thinking": true}
EXTRA_BODY={}
